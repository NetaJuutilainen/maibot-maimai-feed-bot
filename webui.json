{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages"
  ],
  "workspace_title": "麦麦要吃那个！",
  "pages": [
    {
      "mode": "custom",
      "id": "mapping",
      "title": "投喂商店管理",
      "description": "投喂商店管理（全局/群切换）+ 麦麦身体联动映射：定食组合、克数与解析校验",
      "icon": "settings",
      "entry": "webui/mapping.html",
      "layout": "document",
      "queries": {
        "overview": {
          "api": "webui_mapping_overview",
          "version": "1",
          "parameters": {
            "refresh": {
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "actions": {
        "set_mapping": {
          "api": "webui_mapping_set",
          "version": "1"
        },
        "item_save": {
          "api": "webui_item_save",
          "version": "1"
        },
        "item_toggle_sale": {
          "api": "webui_item_toggle_sale",
          "version": "1"
        },
        "create_item": {
          "api": "webui_item_create",
          "version": "1"
        }
      }
    }
  ]
}
